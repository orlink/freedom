    "neighbourhood": {
      "summary": "A quarter (квартал) has no elected body and cannot hold a referendum. A general assembly is possible but needs one quarter of residents to attend and is not directly binding. Municipal councillors are elected from municipality-wide party lists, so no councillor answers to the quarter.",
      "direct": {
        "mechanisms": [
          {
            "type": "referendum",
            "kinds": [
              {
                "type": "citizen_initiative",
                "properties": [
                  {
                    "type": "exists",
                    "status": "no",
                    "explanation": "There is no referendum for a part of a municipality such as a квартал.",
                    "laws": [
                      "dcpa"
                    ]
                  }
                ]
              },
              {
                "type": "veto_referendum",
                "properties": [
                  {
                    "type": "exists",
                    "status": "no",
                    "explanation": "There is no referendum for a part of a municipality such as a квартал.",
                    "laws": [
                      "dcpa"
                    ]
                  }
                ]
              },
              {
                "type": "mandatory_referendum",
                "properties": [
                  {
                    "type": "exists",
                    "status": "no",
                    "explanation": "There is no referendum for a part of a municipality such as a квартал.",
                    "laws": [
                      "dcpa"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "general_assembly",
            "name": "General assembly of the population (общо събрание на населението)",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Can be held for a municipality, district, кметство, settlement or quarter, including residential areas (квартали) of up to 10,000 inhabitants.",
                "laws": [
                  "dcpa",
                  "const"
                ]
              },
              {
                "type": "binding",
                "status": "partial",
                "explanation": "Not directly binding: the municipal council or mayor must issue the acts that implement it within one month.",
                "laws": [
                  "dcpa"
                ]
              },
              {
                "type": "no_quorum",
                "status": "no",
                "explanation": "One quarter of eligible voters must attend (one third in places of up to 150 inhabitants). If not, after one hour it may proceed only with one tenth. In a quarter of 10,000 that is 1,000 people in one room.",
                "laws": [
                  "dcpa"
                ]
              },
              {
                "type": "citizen_triggered",
                "status": "yes",
                "explanation": "The mayor must convene it on request of 1/50 of eligible voters, at least 20 people.",
                "laws": [
                  "dcpa"
                ]
              },
              {
                "type": "reasonable_signatures",
                "status": "yes",
                "explanation": "1/50 of voters, at least 20 people.",
                "laws": [
                  "dcpa"
                ]
              }
            ]
          }
        ]
      },
      "representative": {
        "mechanisms": [
          {
            "type": "council",
            "name": "Neighbourhood council",
            "properties": [
              {
                "type": "exists",
                "status": "no",
                "explanation": "The only constituent units of a municipality are кметства and districts (райони). The law provides no body for a quarter.",
                "laws": [
                  "lsga"
                ]
              }
            ]
          },
          {
            "type": "upper_council_seat",
            "name": "Own member of the municipal council",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Every municipality has a directly elected council.",
                "laws": [
                  "const",
                  "lsga"
                ]
              },
              {
                "type": "binding_powers",
                "status": "yes",
                "explanation": "The council decides local matters, including the quarter's, and adopts the budget.",
                "laws": [
                  "lsga"
                ]
              },
              {
                "type": "individual_vote",
                "status": "partial",
                "explanation": "Party lists with one optional preference vote. A preference changes the list order only if it reaches 7% of the votes cast for that list.",
                "laws": [
                  "ec"
                ]
              },
              {
                "type": "local_constituency",
                "status": "no",
                "explanation": "Seats are allocated across the whole municipality (Hare-Niemeyer), so no councillor is elected by, or answers to, a particular quarter.",
                "laws": [
                  "ec"
                ]
              },
              {
                "type": "recall",
                "status": "no",
                "explanation": "The law lists the grounds for early termination of a mandate (resignation, incapacity, absences, etc.); recall by voters is not among them.",
                "laws": [
                  "lsga"
                ]
              }
            ]
          }
        ]
      }
    },
    "village": {
      "summary": "A village that is a кметство elects its own mayor and can hold a local referendum, but has no council and no budget of its own. In smaller villages the municipal mayor appoints a deputy (кметски наместник) instead.",
