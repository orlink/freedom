              }
            ]
          }
        ]
      }
    },
    "entrance": {
      "summary": "Owners can organise a condominium per entrance, with a general assembly of owners and an elected management board. Quorum is low and falls to zero on the next day.",
      "direct": {
        "mechanisms": [
          {
            "type": "general_assembly",
            "name": "General assembly of owners",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Where a building has more than one entrance, it can be managed separately for each entrance.",
                "citations": [
                  {
                    "law": "cma",
                    "article": "Art. 8(2)",
                    "checked": true
                  }
                ]
              },
              {
                "type": "binding",
                "status": "yes",
                "explanation": "Decisions of the general assembly bind owners, users and occupants, including new ones.",
                "citations": [
                  {
                    "law": "cma",
                    "article": "Art. 11(4)",
                    "checked": true
                  }
                ]
              },
              {
                "type": "no_quorum",
                "status": "partial",
                "explanation": "51% of ideal shares must be present; after one hour 26% suffice; if still not, the meeting is held the next day with whoever attends.",
                "citations": [
                  {
                    "law": "cma",
                    "article": "Art. 15(1)-(3)",
                    "checked": true
                  }
                ]
              },
              {
                "type": "citizen_triggered",
                "status": "yes",
                "explanation": "Owners holding at least 20% of the ideal shares can require the meeting to be convened.",
                "citations": [
                  {
                    "law": "cma",
                    "article": "Art. 12(2)",
                    "checked": true
                  }
                ]
              },
              {
                "type": "broad_scope",
                "status": "yes",
                "explanation": "The assembly adopts the house rules, budget, contributions, the repair plan, loans and the use of common areas.",
                "citations": [
                  {
                    "law": "cma",
                    "article": "Art. 11(1)",
                    "checked": true
                  }
                ]
              },
              {
                "type": "own_means",
                "status": "yes",
                "explanation": "The assembly sets the contributions to the repair and renovation fund.",
                "citations": [
                  {
                    "law": "cma",
                    "article": "Art. 11(1)(7)",
                    "checked": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "representative": {
        "mechanisms": [
          {
            "type": "executive",
            "name": "Management board / manager",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "The executive body is a management board or a single manager.",
