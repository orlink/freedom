        "mechanisms": [
          {
            "type": "referendum",
            "name": "Local referendum",
            "kinds": [
              {
                "type": "citizen_initiative",
                "properties": [
                  {
                    "type": "exists",
                    "status": "yes",
                    "explanation": "A local referendum can be held for a кметство.",
                    "laws": [
                      "dcpa"
