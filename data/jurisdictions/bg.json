  "levels": {
    "individual": {
      "summary": "Personal autonomy is protected by the Constitution.",
      "direct": {
        "mechanisms": [
          {
            "type": "personal_autonomy",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Property is guaranteed and private property is inviolable; privacy and the home are inviolable.",
                "citations": [
                  {
                    "law": "const",
                    "article": "Art. 17(1), (3)",
                    "checked": true
                  },
                  {
                    "law": "const",
                    "article": "Art. 32(1)",
                    "checked": true
                  },
                  {
                    "law": "const",
                    "article": "Art. 33(1)",
                    "checked": true
                  }
                ]
              },
              {
                "type": "no_outside_override",
                "status": "partial",
                "explanation": "These rights can be restricted by statute on the grounds the Constitution allows, e.g. entry into a home with consent or by court order."
              }
            ]
          }
        ]
      },
      "representative": {
        "applicable": false,
        "note": "Individuals decide for themselves; representation does not apply."
      }
    },
    "market": {
