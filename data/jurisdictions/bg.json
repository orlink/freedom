                    "checked": true
                  }
                ]
              },
              {
                "type": "local_constituency",
                "status": "yes",
                "explanation": "Only the owners of this entrance (or building) elect them."
              },
              {
                "type": "recall",
                "status": "yes",
                "explanation": "The term is up to two years, and the general assembly can end it early for failure to perform.",
                "citations": [
