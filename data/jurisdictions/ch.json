    "building": {
      "summary": "Condominium owners decide in an owners' assembly and appoint an administrator. If the first meeting lacks a quorum, a second one needs only a third of owners.",
      "direct": {
        "mechanisms": [
          {
            "type": "general_assembly",
            "name": "Owners' assembly",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "The assembly of condominium owners decides on joint administration.",
                "citations": [
                  {
                    "law": "zgb",
                    "article": "Art. 712m"
                  }
                ]
              },
              {
                "type": "binding",
                "status": "yes",
                "citations": [
                  {
                    "law": "zgb",
                    "article": "Art. 712m"
                  }
                ]
              },
              {
                "type": "no_quorum",
                "status": "partial",
                "explanation": "Half of the owners holding half of the shares (and at least two) must attend; a second meeting, at least ten days later, needs one third.",
                "citations": [
                  {
                    "law": "zgb",
                    "article": "Art. 712p(1)-(3)",
                    "checked": true
                  }
                ]
              },
              {
                "type": "citizen_triggered",
                "status": "yes",
                "explanation": "Owners representing one fifth can demand a meeting (association law applies by reference).",
                "citations": [
                  {
                    "law": "zgb",
                    "article": "Art. 712m(2) with Art. 64(3)"
                  }
                ]
              },
              {
                "type": "own_means",
                "status": "yes",
                "explanation": "Owners decide on contributions and the renewal fund.",
                "citations": [
                  {
                    "law": "zgb",
                    "article": "Art. 712l, 712m(1)"
                  }
                ]
              }
            ]
          }
        ]
      },
      "representative": {
        "mechanisms": [
          {
            "type": "executive",
            "name": "Administrator",
            "properties": [
              {
                "type": "exists",
