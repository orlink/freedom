              { "type": "exists", "status": "yes", "citations": [ { "law": "go", "article": "(article to be added)" } ] },
              { "type": "binding", "status": "yes" },
              { "type": "no_quorum", "status": "yes" },
              { "type": "reasonable_signatures", "status": "yes", "explanation": "3,000 signatures." },
              { "type": "concrete_proposals", "status": "yes" }
