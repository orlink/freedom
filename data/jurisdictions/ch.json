          "direct": { "mechanisms": [
            { "type": "initiative", "properties": [
              { "type": "exists", "status": "yes", "citations": [ { "law": "kv", "article": "Art. 23–24" } ] },
              { "type": "binding", "status": "yes" },
              { "type": "no_quorum", "status": "yes" },
              { "type": "reasonable_signatures", "status": "yes", "explanation": "6,000 signatures.", "citations": [ { "law": "kv", "article": "Art. 24" } ] },
              { "type": "concrete_proposals", "status": "yes" }
            ] },
            { "type": "referendum", "properties": [
              { "type": "exists", "status": "yes", "citations": [ { "law": "kv", "article": "Art. 32–33" } ] },
              { "type": "binding", "status": "yes" },
              { "type": "no_quorum", "status": "yes" },
              { "type": "reasonable_signatures", "status": "yes", "explanation": "3,000 signatures.", "citations": [ { "law": "kv", "article": "Art. 33" } ] },
              { "type": "broad_scope", "status": "yes", "explanation": "Includes financial referendums on large expenditures." }
            ] }
          ] },
          "representative": { "mechanisms": [ { "type": "council", "name": "Kantonsrat", "properties": [
            { "type": "exists", "status": "yes" },
            { "type": "binding_powers", "status": "yes" },
            { "type": "individual_vote", "status": "yes", "explanation": "Open lists." },
            { "type": "local_constituency", "status": "partial", "explanation": "18 electoral districts." },
            { "type": "recall", "status": "no" }
          ] } ] }
        },
        "county": {
          "summary": "Districts (Bezirke) mainly supervise; their officials are elected by district voters.",
          "direct": { "mechanisms": [ { "type": "referendum", "properties": [ { "type": "exists", "status": "no" } ] } ] },
          "representative": { "mechanisms": [ { "type": "executive", "name": "Statthalter / Bezirksrat", "properties": [
            { "type": "exists", "status": "yes" },
            { "type": "binding_powers", "status": "partial", "explanation": "Mostly supervisory and administrative powers." },
            { "type": "individual_vote", "status": "yes" },
            { "type": "local_constituency", "status": "yes" },
            { "type": "recall", "status": "no" }
          ] } ] }
        }
      }
    },
    {
      "name": "City of Zürich",
      "match": { "city": ["Zürich", "Zurich"] },
      "levels": {
