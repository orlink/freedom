  "levels": {
    "individual": {
      "summary": "Personal liberty, privacy and property are guaranteed by the Federal Constitution.",
      "direct": {
        "mechanisms": [
          {
            "type": "personal_autonomy",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Right to personal freedom, privacy and property.",
                "citations": [
                  {
                    "law": "bv",
                    "article": "Art. 10, 13, 26"
                  }
                ]
              },
              {
                "type": "no_outside_override",
                "status": "partial",
                "explanation": "Restrictions need a legal basis, a public interest and proportionality.",
                "citations": [
                  {
                    "law": "bv",
                    "article": "Art. 36"
                  }
                ]
              }
            ]
          }
        ]
      },
      "representative": {
