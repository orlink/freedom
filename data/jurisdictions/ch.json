            { "type": "referendum", "properties": [
              { "type": "exists", "status": "yes" },
              { "type": "binding", "status": "yes" },
              { "type": "no_quorum", "status": "yes" },
              { "type": "citizen_triggered", "status": "yes" },
              { "type": "reasonable_signatures", "status": "yes", "explanation": "2,000 signatures." },
              { "type": "broad_scope", "status": "yes", "explanation": "Includes the budget and large expenditures." }
            ] }
          ] },
          "representative": { "mechanisms": [
            { "type": "council", "name": "Gemeinderat", "properties": [
              { "type": "exists", "status": "yes" },
              { "type": "binding_powers", "status": "yes" },
              { "type": "individual_vote", "status": "yes", "explanation": "Open lists." },
              { "type": "local_constituency", "status": "yes" },
              { "type": "recall", "status": "no" },
              { "type": "own_means", "status": "yes", "explanation": "The city sets its own tax multiplier." }
            ] },
            { "type": "executive", "name": "Stadtrat (city executive)", "properties": [
              { "type": "exists", "status": "yes" },
              { "type": "binding_powers", "status": "yes" },
