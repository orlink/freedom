    "nonprofit": {
      "summary": "People can form non-profit associations and foundations and govern them through a members' assembly and an elected board.",
      "direct": {
        "mechanisms": [
          {
            "type": "personal_autonomy",
            "name": "Freedom of association",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
