    "neighbourhood": {
      "summary": "A neighbourhood has no public decision-making body and no local referendum. Residents elect, by single transferable vote, several councillors for a local electoral area that covers more than their neighbourhood.",
      "direct": {
        "mechanisms": [
          {
            "type": "referendum",
            "properties": [
              {
                "type": "exists",
                "status": "no",
                "explanation": "Irish law provides no citizen-initiated local referendum. The only local plebiscites (2019, on directly elected mayors) were called by the government."
              }
            ]
          }
        ]
      },
      "representative": {
        "mechanisms": [
          {
            "type": "council",
            "name": "Neighbourhood council",
            "properties": [
              {
                "type": "exists",
                "status": "no",
                "explanation": "No statutory body below the municipal district. Residents' associations are private."
              }
            ]
          },
          {
            "type": "upper_council_seat",
            "name": "Own members of the city/county council",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Every area elects members of its city or county council.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 28A.2",
                    "checked": true
                  }
                ]
              },
              {
                "type": "binding_powers",
                "status": "yes",
                "explanation": "The council decides local matters, including the neighbourhood's."
              },
              {
                "type": "individual_vote",
                "status": "yes",
                "explanation": "Councillors are elected by proportional representation with the single transferable vote: voters rank individual candidates."
              },
              {
                "type": "local_constituency",
                "status": "partial",
                "explanation": "Councillors are elected in multi-seat local electoral areas, each covering several neighbourhoods or a district around a town.",
                "citations": [
                  {
                    "law": "lga2001",
                    "article": "s. 23"
                  }
                ]
              },
              {
                "type": "recall",
                "status": "no",
                "explanation": "There is no recall of elected representatives in Irish law."
              }
            ]
          }
        ]
      }
    },
