  "levels": {
    "home": {
      "summary": "The dwelling of every citizen is inviolable, and property rights are protected by the Constitution.",
      "direct": {
        "mechanisms": [
          {
            "type": "household",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "The dwelling of every citizen is inviolable, and property rights are protected by the Constitution.",
                "laws": [
                  "bunreacht"
                ]
              },
              {
                "type": "no_outside_override",
                "status": "partial",
                "explanation": "The dwelling can be entered 'in accordance with law'.",
                "laws": [
                  "bunreacht"
                ]
              }
            ]
          }
        ]
      },
      "representative": {
        "applicable": false,
        "note": "The people in a home decide for themselves; representation does not apply."
      }
    },
    "individual": {
      "summary": "Personal rights, including property and the inviolability of the dwelling, are protected by the Constitution.",
      "direct": {
        "mechanisms": [
          {
            "type": "personal_autonomy",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "The State guarantees to defend and vindicate personal rights, including property; the dwelling is inviolable.",
                "laws": [
                  "bunreacht"
                ]
              },
              {
                "type": "no_outside_override",
                "status": "partial",
                "explanation": "Rights may be regulated by law; the dwelling can be entered 'in accordance with law'.",
                "laws": [
                  "bunreacht"
                ]
              }
            ]
          }
        ]
      },
      "representative": {
        "applicable": false,
        "note": "Individuals decide for themselves."
      }
    },
    "business": {
      "summary": "People can start a business and govern it themselves through the owners' meeting and the managers they elect.",
      "direct": {
        "mechanisms": [
          {
            "type": "personal_autonomy",
            "name": "Free enterprise",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Anyone may start and run a business.",
                "laws": [
                  "bunreacht"
                ]
              },
              {
                "type": "no_outside_override",
                "status": "partial",
                "explanation": "Licensing and permit regimes restrict entry into many activities.",
                "laws": [
                  "bunreacht",
                  "ca2014"
                ]
              }
            ]
          },
          {
            "type": "general_assembly",
            "name": "Partners general meeting",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Partners in a partnership decide together, by majority on ordinary matters and unanimously on changing the business.",
                "laws": [
                  "pa1890"
                ]
              },
              {
                "type": "binding",
                "status": "yes",
                "explanation": "Its resolutions bind the company.",
                "laws": [
                  "pa1890"
                ]
              },
              {
                "type": "broad_scope",
                "status": "yes",
                "explanation": "Owners decide the company's statutes, profits and leadership.",
                "laws": [
                  "pa1890"
                ]
              },
              {
                "type": "own_means",
                "status": "yes",
                "explanation": "The partnership or company controls its own capital and income.",
                "laws": [
                  "pa1890"
                ]
              }
            ]
          },
          {
            "type": "general_assembly",
            "name": "Shareholders general meeting",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Shareholders of a company decide in a general meeting.",
                "laws": [
                  "ca2014"
                ]
              },
              {
                "type": "binding",
                "status": "yes",
                "explanation": "Its resolutions bind the company.",
                "laws": [
                  "ca2014"
                ]
              },
              {
                "type": "broad_scope",
                "status": "yes",
                "explanation": "Owners decide the company's statutes, profits and leadership.",
                "laws": [
                  "ca2014"
                ]
              },
              {
                "type": "own_means",
                "status": "yes",
                "explanation": "The company controls its own capital and income.",
                "laws": [
                  "ca2014"
                ]
              }
            ]
          },
          {
            "type": "general_assembly",
            "name": "Cooperative general meeting",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Members of a co-operative society decide in its general meeting, usually one member one vote.",
                "laws": [
                  "ips"
                ]
              },
              {
                "type": "binding",
                "status": "yes",
                "explanation": "Its resolutions bind the company.",
                "laws": [
                  "ips"
                ]
              },
              {
                "type": "broad_scope",
                "status": "yes",
                "explanation": "Members decide the statutes, the use of any surplus and the board.",
                "laws": [
                  "ips"
                ]
              },
              {
                "type": "own_means",
                "status": "yes",
                "explanation": "The cooperative controls its own capital and income.",
                "laws": [
                  "ips"
                ]
              }
            ]
          }
        ]
