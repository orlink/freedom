    "country": {
      "summary": "Every constitutional change needs a referendum, decided by a simple majority with no turnout quorum. But only parliament can start one; citizens cannot. The Dáil is elected by single transferable vote in 3- to 5-seat constituencies.",
      "direct": {
        "mechanisms": [
          {
            "type": "referendum",
            "name": "Constitutional referendum",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Every constitutional amendment is submitted to the people.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 46.2",
                    "checked": true
                  }
                ]
              },
              {
                "type": "binding",
                "status": "yes",
                "explanation": "An approved amendment is signed into law; a vetoed ordinary proposal cannot be enacted.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 46.5"
                  }
                ]
              },
              {
                "type": "no_quorum",
                "status": "yes",
                "explanation": "Constitutional amendments pass with a majority of votes cast. Ordinary-bill referendums are vetoed only if a majority votes no and that majority is at least a third of the register.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 47.1",
                    "checked": true
                  },
                  {
                    "law": "bunreacht",
                    "article": "Art. 47.2.1°",
                    "checked": true
                  }
                ]
              },
              {
                "type": "citizen_triggered",
                "status": "no",
                "explanation": "Amendments are initiated only in the Dáil as a Bill. A referendum on an ordinary bill requires a petition by a Seanad majority and a third of the Dáil.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 46.2",
                    "checked": true
                  },
                  {
                    "law": "bunreacht",
                    "article": "Art. 27",
                    "checked": true
                  }
                ]
              },
              {
                "type": "concrete_proposals",
                "status": "yes",
                "explanation": "Voters decide on the worded amendment bill."
              },
              {
                "type": "broad_scope",
                "status": "partial",
                "explanation": "Only constitutional amendments and bills referred under Art. 27; ordinary laws are not subject to referendum.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 27",
                    "checked": true
                  }
                ]
              }
            ]
          },
          {
            "type": "initiative",
            "properties": [
              {
                "type": "exists",
                "status": "no",
                "explanation": "The Constitution has no citizens' initiative."
              }
            ]
          }
        ]
      },
      "representative": {
