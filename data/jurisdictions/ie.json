              },
              {
                "type": "individual_vote",
                "status": "yes",
                "explanation": "Directors are elected individually by the members.",
                "laws": [
                  "mud2011",
                  "ca2014"
                ]
              },
              {
                "type": "recall",
                "status": "yes",
                "explanation": "Members can remove a director by ordinary resolution.",
                "laws": [
