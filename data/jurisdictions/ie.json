  "levels": {
    "individual": {
      "summary": "Personal rights, including property and the inviolability of the dwelling, are protected by the Constitution.",
      "direct": {
        "mechanisms": [
          {
            "type": "personal_autonomy",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "The State guarantees to defend and vindicate personal rights, including property; the dwelling is inviolable.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 40.3",
                    "checked": true
                  },
                  {
                    "law": "bunreacht",
                    "article": "Art. 40.5",
                    "checked": true
                  }
                ]
              },
              {
                "type": "no_outside_override",
                "status": "partial",
                "explanation": "Rights may be regulated by law; the dwelling can be entered 'in accordance with law'.",
                "citations": [
                  {
                    "law": "bunreacht",
                    "article": "Art. 40.5",
                    "checked": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "representative": {
        "applicable": false,
        "note": "Individuals decide for themselves."
      }
    },
    "market": {
      "summary": "Private property and free enterprise are protected, subject to regulation for the common good.",
      "direct": {
        "mechanisms": [
          {
            "type": "personal_autonomy",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
