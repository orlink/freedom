              }
            ]
          }
        ]
      }
    },
    "building": {
      "summary": "Apartment owners are members of an owners' management company, which decides in members' meetings and is run by directors they elect. The sinking fund is set by the members.",
      "direct": {
        "mechanisms": [
          {
            "type": "general_assembly",
            "name": "Members' meeting of the owners' management company",
            "properties": [
              {
                "type": "exists",
                "status": "yes",
                "explanation": "Each multi-unit development has an owners' management company whose members are the unit owners.",
                "citations": [
                  {
                    "law": "mud2011",
                    "article": "s. 2–3"
                  }
                ]
              },
              {
                "type": "binding",
                "status": "yes",
                "explanation": "Resolutions bind the company and the owners under company law and the house rules.",
                "citations": [
                  {
                    "law": "mud2011",
                    "article": "s. 23"
                  }
                ]
              },
              {
                "type": "no_quorum",
                "status": "unknown",
                "explanation": "Meeting quorum follows the company's constitution and company law; not yet checked.",
                "citations": [
                  {
                    "law": "ca2014",
                    "article": "s. 181"
                  }
                ]
              },
              {
                "type": "citizen_triggered",
                "status": "yes",
                "explanation": "Members holding at least 10% of voting rights can requisition a general meeting.",
                "citations": [
                  {
                    "law": "ca2014",
                    "article": "s. 178(3)"
                  }
                ]
              },
              {
                "type": "own_means",
                "status": "yes",
                "explanation": "Each owner pays into a sinking fund; the default is €200 per unit a year, or another amount agreed by a members' meeting.",
                "citations": [
                  {
                    "law": "mud2011",
                    "article": "s. 19(3), (5)",
                    "checked": true
                  }
                ]
              }
            ]
          }
        ]
      },
